	(text "Hook-up to a UF1 v1.2 board:"
		(exclude_from_sim no)
		(at 20.32 259.08 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "06d07e89-7a7d-4f31-853e-30ca43c1970b")
	)
	(text "1. +9V from C1 + (or the D1 cathode), GND from J2, IN tapped from the IN pad (J3 pin 1)."
		(exclude_from_sim no)
		(at 20.32 265.43 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "14d4171f-b31c-479c-9fa0-e210e98ff7f3")
	)
	(text "2. Unsolder the vactrol LED leads from U3 pads 1/2 and run them to J4 (anode) / J5 (cathode). Leave the LDR on pads 3/4."
		(exclude_from_sim no)
		(at 20.32 271.78 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "348e6a0c-306e-4bc0-955a-f1a3a1cd57ae")
	)
	(text "DRIVER U2B + Q1: current sink, I_LED = ENVD / 330 (0-18 mA)"
		(exclude_from_sim no)
		(at 199.39 140.97 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "3cff2a46-b3ed-460d-ba62-4fe6bb0f7bfa")
	)
	(text "Start: SENS mid, DECAY mid, COMP parts out, TILT 33n. Compare low E vs high E, then try COMP and TILT 47n / 22n."
		(exclude_from_sim no)
		(at 20.32 284.48 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "7730fcaa-cff5-4824-994c-86d052fa4ac6")
	)
	(text "3. ENV on the board then does nothing (its wiper is open). Use SENS here instead."
		(exclude_from_sim no)
		(at 20.32 278.13 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left bottom)
		)
		(uuid "78e97eee-263b-4846-a666-52a65622870c")
	)
	(text "CONNECTIONS (to a UF1 v1.2 board) + POWER"
		(exclude_from_sim no)
		(at 16.51 19.05 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "ac85b574-edfa-4b2f-aa62-88925c1296a0")
	)
	(text "U2A (LM358): ENVD = 2 x (ENV - VB), referenced to GND; ENV unloaded"
		(exclude_from_sim no)
		(at 16.51 140.97 0)
		(effects
			(font
				(size 2 2)
				(bold yes)
			)
			(justify left bottom)
		)
		(uuid "b2e46ac4-8f58-4bda-92fd-e8a98b82ef4c")
	)
